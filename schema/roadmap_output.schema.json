{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roadmap Output",
  "description": "The structure the LLM (or, for now, a human-written sample) must produce for a generated roadmap.",
  "type": "object",

  "required": ["paths"],

  "properties": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",

        "required": ["degree", "branch", "roadmap_steps", "rationale"],

        "properties": {
          "degree": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "roadmap_steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}
